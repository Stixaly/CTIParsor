# ---------------------------------------------------------------------------
# LLM Provider — choose one: anthropic | gemini | mistral | ollama | lmstudio | vllm
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Per-request timeout for LLM API calls (seconds).
# If the server doesn't respond within this time the chunk is skipped and the
# pipeline continues.  Raise for large local models on slow hardware.
LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Anthropic (default)
# Get your key at: https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
# Note: Requires 'openai' python package (pip install openai)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# Mistral AI
# Get your key at: https://console.mistral.ai/
# Models: mistral-small-latest | mistral-medium-latest | mistral-large-latest
# ---------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ---------------------------------------------------------------------------
# LM Studio (Self-Hosted)
# Default port for LM Studio local server is 1234
# ---------------------------------------------------------------------------
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=lmstudio-model

# ---------------------------------------------------------------------------
# vLLM (Self-Hosted / Enterprise)
# Default port for vLLM local server is 8000
# ---------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=vllm-model

# ---------------------------------------------------------------------------
# Ollama (self-hosted — FREE, zero API costs, runs fully local)
# Install: https://ollama.ai  then pull a model before first use.
#
# Recommended models for CTI extraction (best → fastest):
#   mistral-nemo   ~7 GB  — best JSON adherence, handles long CTI reports well
#   mistral        ~4 GB  — excellent quality/size ratio, good structured output
#   llama3.2       ~2 GB  — fastest, adequate for short reports
#
# Pull command: ollama pull mistral
# For a remote instance: OLLAMA_BASE_URL=http://your-server:11434
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Keep this line. Deleting it does not fall back to mistral — the code's own
# default is llama3.2, which is the fastest of the three and the weakest at
# structured output.
OLLAMA_MODEL=mistral

# ---------------------------------------------------------------------------
# CVE enrichment — Stage 2f
#
# Looks each extracted CVE up on the public CIRCL API to add a description and a
# CVSS v3 score to its STIX Vulnerability object.  OFF by default, and that is
# deliberate: Stages 1, 2, 4 and 5 are documented as fully offline, so an
# external call is opt-in the same way VISION_PROVIDER is.
#
# Results are cached in cti_stix.db (table `cve_cache`), misses included, so an
# unknown CVE is not re-fetched on every run.  Bounded per run: at most 25
# lookups and 30 seconds, because a report carrying 200 CVEs would otherwise add
# minutes of sequential 5-second timeouts to the pipeline.
# ---------------------------------------------------------------------------
# CVE_ENRICHMENT=1

# ---------------------------------------------------------------------------
# Vision — Stage 1f figure reading (ADR-0032, ADR-0033)
#
# Deliberately SEPARATE from LLM_PROVIDER above, for two measured reasons:
#   1. None of the models recommended for Stage 3 can see.  mistral, mistral-nemo
#      and llama3.2 are text-only; pointing Stage 1f at OLLAMA_MODEL reads
#      nothing, and a text model handed an image does not error — it invents.
#   2. The best model for a console screenshot is not the best model for prose.
#      Measured on this corpus: claude-haiku-4-5 got the triage right 3/3 where
#      claude-opus-5 got 2/3, at $0.0027 per figure against $0.028.
#
# The endpoint and the credential are shared with Stage 3 (OLLAMA_BASE_URL,
# MISTRAL_API_KEY, ANTHROPIC_API_KEY) — only the model differs.
#
#   none       (default) Stage 1f is off; figures are not read
#   anthropic  default model claude-haiku-4-5
#   ollama     default model qwen3.8 — needs a model with the `vision`
#              capability; check with: curl -s $OLLAMA_BASE_URL/api/tags
#   mistral    VISION_MODEL is REQUIRED — no default is assumed, because no
#              vision-capable Mistral model name was verified against a live
#              account and a guessed one fails confusingly
#
# The model is probed for image support before any figure is sent.  A model that
# cannot see disables Stage 1f with a warning; it is never called anyway.
# ---------------------------------------------------------------------------
VISION_PROVIDER=none
VISION_MODEL=
VISION_TIMEOUT_S=120

# Figure reads kept in flight.  Ollama sits at 1 (ADR-0033 §5: one GPU, shared
# with the delegation workflow), and measurement gives a second reason: raising
# it to 4 did overlap the work (1.89x) but inflated each call from ~43s to
# ~127s, so throughput per figure got WORSE — 40.9s against 36.3s.  A figure
# read ships a large image and generates hundreds of tokens back, so four in
# flight contend for memory bandwidth instead of filling an idle pipe.
#
# Raise it for a hosted endpoint or a multi-GPU host, where that arithmetic
# differs.  Requests beyond the server's own OLLAMA_NUM_PARALLEL simply queue,
# each still burning VISION_TIMEOUT_S.  The anthropic and mistral backends use
# 4 and ignore this.
# VISION_CONCURRENCY=1

# Waives the capability probe above.  Only set this when you KNOW your model
# reads images and its provider does not publish a capability endpoint we can
# read (Mistral).  It logs a warning every time it fires.
# VISION_ASSUME_CAPABLE=1

# ---------------------------------------------------------------------------
# HuggingFace Hub (optional — speeds up model downloads)
# Without a token, downloads are rate-limited to ~36 kB/s per file.
# With a free token, limits are removed and speeds are typical download rates.
# Get a free token at: https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------------------------
# NLP Model Configuration (ADR-004 — Research-backed upgrades)
# ---------------------------------------------------------------------------

# Stage 2c — TTP Semantic Matching embedding model
# Default: all-MiniLM-L6-v2 (80 MB, fast, general English)
# Recommended upgrade: ehsanaghaei/SecureBERT-Plus (500 MB, security-domain,
#   better recall on security-jargon TTP phrases — CTiKG paper, F1+8-12%)
# After changing this value, rebuild the embedding cache:
#   python scripts/build_indexes.py --only embeddings
TTP_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Stage 2c — semantic TTP precision tuning (ADR precision §2)
# Cosine thresholds are model-specific and resolved automatically (per-model
# defaults, then the embedding manifest, then the overrides below).  Set these
# only to hand-tune; leave unset to use the calibrated defaults for the model.
#   TTP_HIGH_THRESHOLD=0.62     # ≥ this → high confidence (wins over the LLM)
#   TTP_MEDIUM_THRESHOLD=0.48   # ≥ this → medium candidate; < this → discarded
# A 2nd technique matched to the SAME sentence is dropped unless it is within
# this cosine margin of the top match (the main semantic false-positive source):
#   TTP_TOP2_MARGIN=0.05
#
# Taxonomies the semantic matcher may return.  The embedding cache mixes ATT&CK
# with CAPEC, and CAPEC is ~40% of it — but CAPEC catalogues *abstract* attack
# patterns while a CTI report describes *observed* behaviour, so a CAPEC row
# mostly shadows the ATT&CK technique that belongs in the bundle (CAPEC-163
# "Spear Phishing" beside T1566.001).  ATT&CK-only by default; set to "all" to
# restore CAPEC, or list domains to narrow further.
#   TTP_SEMANTIC_DOMAINS=enterprise-attack,mobile-attack,ics-attack

# Stage 3d — Self-verification of relationship claims (ADR-004 P3-A)
# Based on aCTIon paper (NEC Labs, 2023): second LLM pass quotes the supporting
# sentence for each extracted relationship; unsupported claims are removed.
# Effect: reduces relationship hallucination rate from ~27% to ~8%.
# Cost: adds ~1.4× total LLM calls (only chunks with ≥1 relationship are re-checked).
# Recommended: enable for high-value reports; disable for fast/bulk processing.
ENABLE_STIX_VERIFICATION=false
# Minimum relationships in a chunk before verification runs (skip low-yield chunks)
STIX_VERIFY_MIN_RELS=1

# Stage 3f — Self-verification of TTP claims (ADR precision §3)
# TTP analogue of Stage 3d: a second LLM pass must quote the sentence describing
# each LLM-extracted technique's use; unsupported techniques are removed.  TTPs
# already corroborated by a high-confidence semantic match are trusted and skipped,
# so the extra cost tracks Stage 3d (~1.4× calls, not 2×).
# Recommended ON: without it TTPs get no evidence gate at all while relationships
# get two (3d + 3e).  On a 12-page report with zero explicit T-IDs this was the
# single largest source of unsupported techniques.
ENABLE_TTP_VERIFICATION=true
# Minimum single-signal TTPs in a chunk before verification runs
TTP_VERIFY_MIN=1

# Stage 3e — Cross-model consensus (anti-hallucination)
# Runs the SAME chunk through a second provider and uses agreement as a trust
# signal: corroborated relationships gain confidence; single-model ones lose it
# and are downgraded from "observed" so they can't auto-promote in review.
# Stronger than 3d self-verification (two different models, not the same model
# judging itself), but doubles LLM cost on chunks that have relationships.
# CONSENSUS_PROVIDER must differ from LLM_PROVIDER and have its API key set.
ENABLE_CONSENSUS=false
CONSENSUS_PROVIDER=mistral

# Stage 4 — STIX provenance & sharing metadata
# Every bundle object is stamped with a TLP marking (sharing policy) and a
# created_by_ref pointing to an authoring Identity (the pipeline, NOT the actor).
# STIX_TLP: clear (default) | green | amber | red  — uses standard interoperable
# TLP marking IDs that OpenCTI / MISP recognise.
STIX_TLP=clear
# Name of the authoring Identity SDO (created_by_ref target on every object).
STIX_AUTHOR_NAME=CTIParsor

# Stage 2d — CyNER cybersecurity NER
# Default model: PranavaKailash/CyNER-2.0-DeBERTa-v3-base (public, F1 91.88%).
# It replaces the removed aiforsec/cyner-xlm-roberta-base and exposes a dedicated
# Threat_group label. Requires the `sentencepiece` package (deberta-v2 tokenizer).
# Set CYNER_ENABLED=false to skip this stage (Stage 2e / GLiNER is the fallback).
CYNER_ENABLED=true
# Override the model here if needed:
# CYNER_MODEL=PranavaKailash/CyNER-2.0-DeBERTa-v3-base

# Stage 2e — GLiNER / NuNER zero-shot NER
# Discovers entity types CyNER/gazetteer miss: targeted sectors, campaign names,
# attack infrastructure, novel actors & malware not yet in MITRE ATT&CK.
# Paper: "0-CTI" by CY4GATE (2025) — ADR-004 P2-A
#
# Model options (all are drop-in via GLINER_MODEL — same interface, no code change):
#
#   GLiNER models (urchade):
#     urchade/gliner_large-v2.1  — ~800 MB  · RECOMMENDED — best GLiNER accuracy, slower
#     urchade/gliner_medium-v2.1 — ~300 MB  · good accuracy/speed balance, CPU-friendly
#     urchade/gliner_small-v2.1  — ~120 MB  · fastest, lower recall
#
# Note: numind/NuNER-Zero-span and numind/NuNER-Zero were removed from
# HuggingFace (return 401/repo-not-found) — do not use.
#
# To switch: change GLINER_MODEL below and restart (no rebuild needed).
GLINER_MODEL=urchade/gliner_large-v2.1
GLINER_THRESHOLD=0.40
# Set to false to disable Stage 2e entirely (saves ~300 MB RAM + CPU time)
GLINER_ENABLED=true

# ---------------------------------------------------------------------------
# Advanced — Stage 3 LLM throughput
# ---------------------------------------------------------------------------

# Number of chunks processed concurrently during LLM enrichment.
# Higher values speed up large reports but increase API cost bursts.
# Lower if you hit rate-limit errors (429).
LLM_PARALLELISM=3

# Save a checkpoint to disk every N completed chunks.
# Lets the pipeline resume from the last checkpoint on crash or interruption.
CHECKPOINT_EVERY=5

# ---------------------------------------------------------------------------
# Chunking (Stage 1)
#
# These variables control how the input text is split before processing.
# Overlap ensures that named entities spanning chunk boundaries are not
# fragmented, allowing the pipeline to deduplicate them correctly.
# Increasing CHUNK_MAX_CHARS reduces LLM call count but may dilute model
# attention on very large contexts.
# ---------------------------------------------------------------------------
# Maximum characters per chunk sent to the LLM. Default: 3000.
# CHUNK_MAX_CHARS=3000
# Characters from the end of a chunk repeated at the start of the next.
# Default: 400.
# CHUNK_OVERLAP=400

# ---------------------------------------------------------------------------
# LLM request limits
#
# These limits constrain the size and retry behavior of LLM interactions.
# LLM_MAX_RESPONSE_LENGTH truncates the output string. If set lower than
# what LLM_MAX_OUTPUT_TOKENS allows, valid JSON responses may be cut off,
# rendering the chunk invalid and causing data loss. Keep this value above
# LLM_MAX_OUTPUT_TOKENS multiplied by approximately 4 characters per token.
# ---------------------------------------------------------------------------
# Maximum output tokens allowed by the LLM. Default: 8192.
# LLM_MAX_OUTPUT_TOKENS=8192
# Maximum input prompt length in characters. Default: 32000.
# LLM_MAX_PROMPT_LENGTH=32000
# Maximum response length in characters. Default: 48000.
# LLM_MAX_RESPONSE_LENGTH=48000
# Number of retries on transient errors. Default: 3.
# LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Worker (web API)
#
# These settings govern the web API worker process. Each report runs in a
# subprocess and loads NLP models, making memory the primary constraint
# rather than CPU. The timeout covers the entire report lifecycle, including
# Stage 1f and Stage 3, which may approach the limit for figure-heavy
# documents on local models.
# ---------------------------------------------------------------------------
# Maximum reports processed in parallel. Default: 10.
# WORKER_MAX_CONCURRENT=10
# Maximum time per report in seconds. Default: 1800.
# WORKER_JOB_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Logging
#
# Configure log output format, level, and rotation. MAX_LOG_SIZE and
# LOG_BACKUP_COUNT only apply when LOG_FILE is set.
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO.
# LOG_LEVEL=INFO
# Log format: text or json. Default: text.
# LOG_FORMAT=text
# Path to log file. Empty means stdout only. Default: (empty).
# LOG_FILE=
# Log rotation size in bytes. Default: 10485760 (10 MB).
# MAX_LOG_SIZE=10485760
# Number of rotated log files to keep. Default: 5.
# LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Advanced tuning
#
# These are calibrated values. Change one only alongside a measurement that
# says it helped — tests/eval_pipeline.py is the harness for the TTP ones.
#
# Boolean vocabulary, shared by every flag in this file: 1/true/yes/on and
# 0/false/no/off. An unrecognised value falls back to the documented default
# rather than being read as true, so a typo cannot silently enable something.
# ---------------------------------------------------------------------------
# Require technical keywords before proposing a technique. Default: true.
# Accepted values: 1/true/yes/on or 0/false/no/off.
# TTP_KEYWORD_GATE=true
# Rejoin lines split by newlines before semantic matching. Default: true.
# Accepted values: 1/true/yes/on or 0/false/no/off.
# TTP_UNWRAP_LINES=true
# Maximum candidates retained per document. Default: 200.
# TTP_MAX_CANDIDATES=200
# Phrases per GLiNER batch (Stage 2e). Default: 4.
# GLINER_BATCH_SIZE=4
# GLiNER window size in characters. Default: 1600.
# GLINER_CHUNK_CHARS=1600
# Disable spaCy, CyNER, GLiNER, and sentence-transformers. Default: (unset).
# Used by test suites and audit scripts to avoid model downloads.
# Not intended for production configurations.
# Accepted values: 1/true/yes/on or 0/false/no/off.
# SKIP_HEAVY_MODELS=