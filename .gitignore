.env
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
output/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
# scripts/release_files.sh writes the notes and files of a release here (ADR-0085)
/release/
# Reports dropped in input/ stay local — never commit sensitive CTI docs
input/*.pdf
input/*.docx
input/*.html
input/*.txt
# Web UI
uploads/
# Runtime state of a local install (db-identity.json, ADR-0077)
/state/
cti_stix.db
cti_stix.db-shm
cti_stix.db-wal
db_backups/
frontend/node_modules/
frontend/dist/
# MITRE ATT&CK bundle (downloaded by scripts/download_attack.py — ~12 MB, do not commit)
/data/
# Design artefacts — HTML prototypes, not production code
docs/design/
# Detection-rule corpus clones (ADR-0006) — large, owned upstream, fetched by sync_corpora.
/corpora/
# Local registry overlay — private repo URLs + overrides stay local
# (the committed detection_corpora.yaml holds public corpuses).
detection_corpora.local.yaml

# Claude Code local session config (machine-local, not shared)
.claude/

# Stage 2d runtime sentinel — written when the CyNER model cannot be loaded
.cyner_model_unavailable

# Stage 5's old runtime sentinel.  Nothing writes it since the schemas ship with
# the repository (ADR-0069, amendment of 2026-10-10); still ignored, so one an
# older version left in a checkout stays out of git.
.stix2_schemas_missing

# Local .env backups (contain secrets — never commit)
.env.bak*

# Large local archives (a 278 MB CLAUDE.zip was sitting in the repo root)
*.zip

# Air-gap installation bundle (scripts/package_offline_docker.sh, ADR-0054) -- large, rebuilt on demand.
/offline/
# Air-gap corpora bundle, unpacked at the repo root (scripts/package_offline_corpora.sh)
/offline-corpora/

# Written by setup.sh --offline on Docker's classic image store; own overrides stay local too
compose.override.yaml

# Reverse-proxy secrets for the compose `proxy` profile (docs/docker.md)
docker/nginx/certs/
docker/nginx/htpasswd

# DB password materialized from .env for compose.yaml's bind-mounted secret
# (Makefile's docker-up/docker-bootstrap, scripts/docker_smoke.sh)
.secrets/

# Database dumps (scripts/upgrade_postgres_17_to_18.sh) -- they hold every report
/backups/

# Coverage data (pytest --cov, make coverage)
.coverage
.coverage.*
coverage.xml
htmlcov/

