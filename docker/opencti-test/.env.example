# Test values for the throwaway OpenCTI of ADR-0090 check A4 (compose.yaml).
# Copy to .env (git-ignored) and fill in: the token is a UUID v4.
OPENCTI_ADMIN_EMAIL=admin@opencti.test
OPENCTI_ADMIN_PASSWORD=
OPENCTI_ADMIN_TOKEN=
OPENCTI_HEALTHCHECK_ACCESS_KEY=
# 32 random bytes, base64 (openssl rand -base64 32): required since OpenCTI 7.
OPENCTI_ENCRYPTION_KEY=
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=
